# ---- Server ----
PORT=5000
# Use 127.0.0.1 on EC2 so the API is only reachable through Nginx.
# (Use 0.0.0.0 later inside Docker containers.)
HOST=127.0.0.1
NODE_ENV=development
# Number of reverse proxies in front of the app (0 locally, 1 behind Nginx).
TRUST_PROXY=0

# ---- Database (MongoDB Atlas connection string) ----
MONGODB_URI=

# ---- Authentication ----
# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=jOwDllBa5M6FemdaCUqYOO9shC3LYUeOstyK3kyeGQv0W4b4kJhF28Z3Ie2
# Formats: 15m, 12h, 1d ...  (also used as the cookie lifetime)
JWT_EXPIRES_IN=1d
# true only when the site is served over HTTPS (browsers drop Secure cookies on plain HTTP).
COOKIE_SECURE=false

# ---- CORS ----
# Comma-separated list of allowed browser origins (only matters if the browser talks
# to the API from a different origin than the page, e.g. during local development).
FRONTEND_URL=http://localhost:5173
